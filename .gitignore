# ============================================
# LineByLine Project - .gitignore
# Stack: React + Vite + Flask + Python
# ============================================

# ------------------------------------------
# 1. Environment and secrets
# ------------------------------------------
.env
.env.*
# Explicitly allow the example env template
!.env.example

# ------------------------------------------
# 2. Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------
# 3. Node.js / React / Vite
# ------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# 4. IDE files
# ------------------------------------------
.vscode/
.idea/
*.iml

# ------------------------------------------
# 5. OS files
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------
# 6. Logs and temporary files
# ------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo

# ------------------------------------------
# 7. Project secrets
# ------------------------------------------
credentials.json
service-account.json
secrets.json
EXPLAINX_TO_LINEBYLINE_MIGRATION_PLAN.md
EXPLAINX_TO_LINEBYLINE_MIGRATION_STATUS.md
